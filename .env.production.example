# ============================================================================
# HAYAT (حیات) — PRODUCTION ENVIRONMENT CONFIGURATION
# Official Portal of Hujjat al-Islam Dr. Zanjirzan Hosseini (zanjirzan.ir)
# ============================================================================

ENVIRONMENT=production
SECRET_KEY=REPLACE_WITH_64_CHAR_CRYPTOGRAPHIC_HEX_SECRET_2026
MAX_CONCURRENT_DEVICES=3

# --- Database & Redis ---
POSTGRES_USER=hikmat_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=hayat_db
REDIS_URL=redis://redis:6379/0

# --- Frontend Public Variables ---
NEXT_PUBLIC_API_URL=https://zanjirzan.ir/api/v1
NEXT_PUBLIC_DEMO_MODE=false
ALLOWED_ORIGINS=https://zanjirzan.ir,https://www.zanjirzan.ir

# --- OTP & Kavenegar SMS Gateway ---
OTP_MODE=production
OTP_EXPIRE_SECONDS=120
OTP_MAX_ATTEMPTS=5
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=YOUR_KAVENEGAR_API_KEY
KAVENEGAR_TEMPLATE=hayat-verify

# --- Zarinpal / Shaparak Payment Gateway ---
PAYMENT_MODE=production
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- AI Multi-Provider Router (DeepSeek V4.1 / OpenRouter Free / Gemini Flash) ---
# Options for AI_PROVIDER: deepseek | openrouter | gemini | groq | local
AI_PROVIDER=deepseek
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.1
AI_STRICT_CORPUS_ONLY=true

# --- Whisper Audio-to-Text ASR (Groq Free Tier) ---
AI_WHISPER_BASE_URL=https://api.groq.com/openai/v1
AI_WHISPER_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AI_WHISPER_MODEL=whisper-large-v3-turbo
